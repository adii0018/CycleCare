# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DATABASE=cyclecare

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting & Proxy Configuration
RATE_LIMIT_REGISTER_PER_10MIN=10
RATE_LIMIT_LOGIN_IP_PER_15MIN=10
RATE_LIMIT_LOGIN_MOBILE_PER_15MIN=5
TRUSTED_PROXY_HOPS=1

# Admin Session & Cookie Configuration
SESSION_COOKIE_NAME=cc_session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=
ADMIN_SESSION_DAYS=14
